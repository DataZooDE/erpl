# name: test/sql/sap_read_table_packed_even_length.test
# description: Boundary values of every DDIC type, through sap_read_table and through
#              sap_rfc_invoke (issue #255 and its audit).
#
#              ZERPL_TYPES_BV / Z_ERPL_TYPES_BV come from scripts/sap/provision.d/
#              26-types-boundary.sh: one column per type -- packed fields at every
#              length/decimals combination, CURR/QUAN, INT1..INT8, FLTP, DECFLOAT, DATS,
#              TIMS, RAW, NUMC, CHAR, ACCP, PREC, LANG, UTCLONG -- and rows MAX (largest
#              value), NEG (most negative), ZERO (initial), SMALL (smallest step), JPY,
#              NONBMP (five U+1F600 fill CHAR(10)) and BMP10.
#
#              Before this file nothing read a packed field of even length holding a
#              full-width value, so DEC(4,1) typed as DECIMAL(3,1) went unnoticed: every
#              fixture value left a spare digit, and no test asserted a precision.
#
#              Not asserted on the read path: what RFC_READ_TABLE itself renders lossily
#              into its fixed-width text (INT2/4/8 minima become '*768-', RAW(n) is cut to
#              n hex characters, FLTP to nine digits, DECFLOAT rounded). Those are limits of
#              SAP's function module, pinned below where they fail loudly; the invoke path
#              carries them exactly and is asserted in full.
# group: [rfc]

require erpl_rfc

require-env ERPL_SAP_ASHOST

require-env ERPL_SAP_SYSNR

require-env ERPL_SAP_USER

require-env ERPL_SAP_PASSWORD

require-env ERPL_SAP_CLIENT

require-env ERPL_SAP_LANG

statement ok
CREATE SECRET abap_trial (
    TYPE sap_rfc,
    ASHOST '${ERPL_SAP_ASHOST}',
    SYSNR '${ERPL_SAP_SYSNR}',
    CLIENT '${ERPL_SAP_CLIENT}',
    USER '${ERPL_SAP_USER}',
    PASSWD '${ERPL_SAP_PASSWORD}',
    LANG '${ERPL_SAP_LANG}'
);

# --- sap_read_table: declared types -------------------------------------------------
# A packed field of LENG n declares DECIMAL(2*(n/2+1)-1, d): never fewer digits than
# DDIC declares (issue #255), the same rule the invoke path uses.

statement ok
CREATE TABLE rt AS SELECT * FROM sap_read_table('ZERPL_TYPES_BV',
    COLUMNS = ['ROW_ID','P1_0','P2_0','P2_1','P2_2','P3_1','P4_1','P4_2','P5_5','P16_2',
               'P30_14','P31_14','P31_0','WAERS','C13_2','C16_2','MEINS','Q13_3','Q14_3',
               'N10','CH10','I1','DT','TM','AC','PR','LG','UT']);

query TT
SELECT column_name, column_type FROM (DESCRIBE rt) WHERE column_name IN
    ('P1_0','P2_0','P2_1','P2_2','P3_1','P4_1','P4_2','P5_5','P16_2','P30_14','P31_14',
     'P31_0','C13_2','C16_2','Q13_3','Q14_3','I1','UT') ORDER BY column_name;
----
C13_2	DECIMAL(13,2)
C16_2	DECIMAL(17,2)
I1	UTINYINT
P16_2	DECIMAL(17,2)
P1_0	DECIMAL(1,0)
P2_0	DECIMAL(3,0)
P2_1	DECIMAL(3,1)
P2_2	DECIMAL(3,2)
P30_14	DECIMAL(31,14)
P31_0	DECIMAL(31,0)
P31_14	DECIMAL(31,14)
P3_1	DECIMAL(3,1)
P4_1	DECIMAL(5,1)
P4_2	DECIMAL(5,2)
P5_5	DECIMAL(5,5)
Q13_3	DECIMAL(13,3)
Q14_3	DECIMAL(15,3)
UT	TIMESTAMP

# --- sap_read_table: every value ----------------------------------------------------

query TTT
SELECT trim(ROW_ID), col, val FROM (
    UNPIVOT (SELECT ROW_ID, coalesce(COLUMNS(* EXCLUDE (ROW_ID))::VARCHAR, 'NULL') FROM rt)
    ON COLUMNS(* EXCLUDE (ROW_ID)) INTO NAME col VALUE val)
WHERE trim(ROW_ID) IN ('MAX', 'NEG')
  AND NOT (col = 'TM' AND trim(ROW_ID) NOT IN ('MAX', 'SMALL'))
ORDER BY 1, 2;
