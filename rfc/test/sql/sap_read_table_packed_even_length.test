# --- both paths agree ---------------------------------------------------------------
# For every column both paths can carry, sap_read_table and sap_rfc_invoke return the
# same value. A path-specific mapping (issue #255 was one) shows up here.

query I
SELECT count(*) FROM (
    UNPIVOT (SELECT ROW_ID, coalesce(COLUMNS(* EXCLUDE (ROW_ID))::VARCHAR, 'NULL') FROM rt)
    ON COLUMNS(* EXCLUDE (ROW_ID)) INTO NAME col VALUE val) a
JOIN (
    UNPIVOT (SELECT ROW_ID, coalesce(COLUMNS(* EXCLUDE (ROW_ID))::VARCHAR, 'NULL') FROM iv)
    ON COLUMNS(* EXCLUDE (ROW_ID)) INTO NAME col VALUE val) b
  ON trim(a.ROW_ID) = trim(b.ROW_ID) AND a.col = b.col
WHERE a.val IS DISTINCT FROM b.val;
----
0
