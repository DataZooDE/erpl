# --- sap_read_table: what RFC_READ_TABLE cannot carry fails loudly ------------------
# The server renders INT2's minimum into a five-character field as '*768-'. That is
# SAP's own truncation; reading it must fail with the text, never yield a number.

statement error
SELECT * FROM sap_read_table('ZERPL_TYPES_BV', COLUMNS = ['ROW_ID', 'I2']);
----
*768-

# --- sap_rfc_invoke: declared types -------------------------------------------------
# The invoke path carries binary values, so every column is asserted, including the
# ones RFC_READ_TABLE cannot render.

statement ok
CREATE TABLE iv AS SELECT unnest(ET_ROWS, recursive := true) FROM sap_rfc_invoke('Z_ERPL_TYPES_BV');

query TTT
SELECT 'T', column_name, column_type FROM (DESCRIBE iv) ORDER BY column_name;
